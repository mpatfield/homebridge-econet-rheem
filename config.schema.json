{
  "pluginAlias": "HomebridgeEconetRheem",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "customUiPath": "./src/homebridge-ui",
  "schema": {
    "type": "object",
    "required": ["email", "password"],
    "properties": {
      "name": {
        "title": "Plugin Name",
        "type": "string",
        "default": "Econet Rheem"
      },
      "email": {
        "title": "Email",
        "type": "string",
        "format": "email",
        "description": "Rheem/Econet account email (Homebridge dedicated account recommended)"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "description": "Rheem/Econet account password"
      },
      "wh_sim_disable": {
        "title": "Disable Water Heater Temperature Simulator",
        "type": "boolean",
        "required": false,
        "description": "See documentation for details"
      },
      "verbose": {
        "title": "Verbose",
        "type": "boolean",
        "required": false,
        "description": "Enable additional debug logging"
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "Required Settings",
      "items": ["email", "password"]
    },
    {
      "type": "fieldset",
      "title": "Advanced Settings",
      "expandable": true,
      "items": ["verbose", "wh_sim_disable"]
    }
  ]
}