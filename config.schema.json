{
  "pluginAlias": "HomebridgeEconetRheem",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Plugin Name",
        "type": "string",
        "default": "Econet Rheem"
      },
      "email": {
        "title": "Email",
        "type": "string",
        "format": "email",
        "required": true,
        "description": "Rheem/Econet account email"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "required": true,
        "description": "Rheem/Econet account password"
      },
      "wh_estimate": {
        "title": "Estimate Water Heater Temp (Beta)",
        "type": "boolean",
        "required": false,
        "description": "Predict the current temp based on the set point, availability, and past recovery rates"
      },
      "wh_input_temp": {
        "title": "Water Heater Input Temp",
        "type": "number",
        "required": false,
        "description": "Optional: setting this will improve the current temp calulcation",
        "condition": {
          "functionBody": "return model.wh_estimate === true"
        }
      },
      "verbose": {
        "title": "Verbose",
        "type": "boolean",
        "required": false,
        "description": "Enable additional debug logging"
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "Required Settings",
      "items": ["email", "password"]
    },
    {
      "type": "fieldset",
      "title": "Advanced Settings",
      "expandable": true,
      "items": ["verbose", "wh_estimate", "wh_input_temp"]
    }
  ]
}