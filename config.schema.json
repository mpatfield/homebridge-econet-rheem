{
  "pluginAlias": "HomebridgeEconetRheem",
  "pluginType": "platform",
  "singular": true,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Plugin Name",
        "type": "string",
        "default": "Econet Rheem"
      },
      "email": {
        "title": "Email",
        "type": "string",
        "format": "email",
        "required": true,
        "description": "Rheem/Econet account email"
      },
      "password": {
        "title": "Password",
        "type": "string",
        "required": true,
        "description": "Rheem/Econet account password"
      },
      "debug": {
        "title": "Debug",
        "type": "boolean",
        "required": false,
        "description": "Enable additional debug logging"
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "Required Settings",
      "items": ["email", "password"]
    },
    {
      "type": "fieldset",
      "title": "Advanced Settings",
      "expandable": true,
      "items": ["debug"]
    }
  ]
}