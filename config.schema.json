{
  "pluginAlias": "HomebridgeEconetRheem",
  "pluginType": "platform",
  "singular": true,
  "customUi": true,
  "customUiPath": "./dist/homebridge-ui",
  "schema": {
    "type": "object",
    "required": ["email", "password"],
    "properties": {
      "name": {
        "title": "Plugin Name",
        "type": "string",
        "default": "Econet Rheem"
      },
      "email": {
        "title": "${config.title.email}",
        "type": "string",
        "format": "email",
        "description": "${config.description.email}"
      },
      "password": {
        "title": "${config.title.password}",
        "type": "string",
        "description": "${config.description.password}"
      },
      "wh_sim_disable": {
        "title": "${config.title.wh_sim_disable}",
        "type": "boolean",
        "required": false,
        "description": "${config.description.wh_sim_disable}"
      },
      "verbose": {
        "title": "${config.title.verbose}",
        "type": "boolean",
        "required": false,
        "description": "${config.description.verbose}"
      }
    }
  },
  "layout": [
    {
      "type": "fieldset",
      "title": "Required Settings",
      "items": ["email", "password"]
    },
    {
      "type": "fieldset",
      "title": "Advanced Settings",
      "expandable": true,
      "items": ["verbose", "wh_sim_disable"]
    }
  ]
}